{
  "version": 2,
  "builds": [
    {
      "src": "api/_vercel.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/score-ring.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/score-ring",
      "dest": "/api/score-ring.ts"
    },
    {
      "src": "/(.*)",
      "dest": "/api/_vercel.ts"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
